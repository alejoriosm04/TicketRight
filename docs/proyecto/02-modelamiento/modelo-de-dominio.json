  "cards": [
    {
      "dot": "amber",
      "title": "Reglas R1–R5",
      "items": [
        "R1: nunca superar el aforo autorizado",
        "R2: una silla solo tiene una asignación activa",
        "R3: la reserva sin pago vence en máximo 10 minutos",
        "R4: ningún pago inicia sin reserva o reventa vigente",
        "R5: cobro confirmado termina en boleta o devolución trazable"
      ]
    },
    {
      "dot": "orange",
      "title": "Reglas R6–R10",
      "items": [
        "R6: el turno respeta una política reconstruible",
        "R7: cada boleta tiene un único titular activo",
        "R8: transferir invalida titularidad y código anteriores",
        "R9: reventa solo dentro de las reglas de reventa del evento",
        "R10: devolución invalida boleta y ajusta pago y liquidación"
      ]
    },
    {
      "dot": "rose",
      "title": "Reglas R11–R14",
      "items": [
        "R11: datos compartidos solo con consentimiento vigente",
        "R12: liquidación solo con movimientos conciliados",
        "R13: todo cobro lleva su desglose: nominal, cargo y parafiscal",
        "R14: toda discrepancia se cierra con una resolución trazable"
      ]
    }
  ]
