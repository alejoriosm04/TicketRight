                <mxCell id="legend" value="&lt;b&gt;Cómo leerlo:&lt;/b&gt; línea continua = interacción inmediata · línea discontinua = trabajo mediante eventos · cilindro = almacenamiento · AD-xxx = decisión relacionada" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#64748b;" parent="1" vertex="1">
                    <mxGeometry x="60" y="985" width="1080" height="26" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
