POSTGRES_PASSWORD=ticketright
DATABASE_URL=postgres://ticketright:ticketright@localhost:5433/ticketright
PORT=3000
PASARELA_PERFIL=normal
PASARELA_RETRASO_MS=500

# Observabilidad (Entrega 3). La app exporta trazas por OTLP a Grafana Alloy y
# escribe logs JSON al archivo que Alloy recoge para Loki.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_FILE=./observability/logs/ventas.log
DEPLOY_ENV=demo

# Fila Space-Based en Redis (AD-006) y bus de eventos en Kafka (AD-002).
# Si se dejan vacíos, la app usa la fila en memoria y el relay solo-PostgreSQL.
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
